# ============================================================
# 数治通 .env 配置示例
# 用法：复制为 .env（项目根目录）后按需修改；也可以直接用环境变量覆盖。
#   cp .env.example .env
# 注意：.env 含密钥，切勿提交到 Git（已在 .gitignore 中排除）。
# ============================================================

# ---------------- Server（服务） ----------------
# 监听地址（容器内保持 0.0.0.0）
SZT_HOST=0.0.0.0
# 监听端口
SZT_PORT=8000
# uvicorn worker 数（开发 1 即可，生产可设为 CPU 核数）
SZT_WORKERS=1
# 允许跨域的前端地址，逗号分隔；* 表示全部允许（生产建议收紧）
SZT_CORS_ORIGINS=*
# 日志级别：debug | info | warning | error
SZT_LOG_LEVEL=info

# ---------------- Database（数据库） ----------------
# 留空 = 使用 SQLite（数据文件在 SZT_DATA_DIR/shuzhitong.db）
# PostgreSQL 示例：postgresql://szt:szt123@shuzhitong-db:5432/shuzhitong
SZT_DB_URL=
# SQLite 数据目录（为空则用 <项目根>/backend/data）
SZT_DATA_DIR=

# ---------------- LLM（大模型，三期智能问数用） ----------------
# deepseek | qwen | openai_compatible | disabled（默认禁用，未配置时优雅降级）
SZT_LLM_PROVIDER=disabled
# 模型接口地址（deepseek/qwen 有默认值；openai_compatible 必须填写）
SZT_LLM_BASE_URL=
# 模型 API Key（妥善保管，不要提交到 Git）
SZT_LLM_API_KEY=
# 模型名称（deepseek/qwen 有默认值）
SZT_LLM_MODEL=
# 调用超时（秒）
SZT_LLM_TIMEOUT=60

# ---------------- Auth（认证） ----------------
# JWT 签名密钥：生产环境必须修改！使用默认值启动时会有 WARNING
SZT_JWT_SECRET=dev-insecure-secret-change-me
# token 有效期（分钟）
SZT_TOKEN_EXPIRE_MINUTES=720

# ---------------- 其他 ----------------
# 是否灌入演示数据（true/false；生产建议设为 false）
SZT_SEED_DEMO_DATA=true

# ---------------- 三期：服务应用 ----------------
# 服务调用限流：每用户每服务每分钟最大调用次数
SZT_SVC_RATE_LIMIT=60
# 智能问数受控查询默认行数上限
SZT_QA_SQL_LIMIT=200

# ---------------- Docker Compose 附加 ----------------
# 前端 API 地址（容器内默认 /api 走 nginx 反代；前后端分离部署时填绝对地址）
SZT_API_BASE=/api
# PostgreSQL 容器（docker compose --profile pg 启用时用）
POSTGRES_DB=shuzhitong
POSTGRES_USER=szt
POSTGRES_PASSWORD=szt123
